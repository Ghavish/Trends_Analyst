# Copy this file to ".env" (same folder) and fill in your IG DEMO details.
# .env is listed in .gitignore, so it is never committed. Never paste these
# values into chats, code or screenshots.

# Web API demo login (the separate username/password set in My IG > Demo accounts)
IG_USERNAME=
IG_PASSWORD=
# The DEMO API key generated in My IG
IG_API_KEY=
# Must be DEMO. broker.py refuses to run with anything else.
IG_ACC_TYPE=DEMO
# Optional: your demo account ID (e.g. "ABC12"). You only have one CFD
# account, so this can stay empty.
IG_ACC_NUMBER=
